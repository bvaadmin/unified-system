# Oracle Database Connection (Migrated from PostgreSQL)
# Oracle Autonomous Database (Mainbase)
DATABASE_URL=oracle+oracledb://username:password@mainbase_high

# Oracle Configuration
ORACLE_USER=your-oracle-username
ORACLE_PASSWORD=your-oracle-password

# Option A: One-way TLS (recommended for ADB TLS-only)
# Place sqlnet.ora and tnsnames.ora in ./oracle_wallet and set:
ORACLE_ONE_WAY_TLS=true
ORACLE_TNS_ADMIN=./oracle_wallet
# TNS alias to use from tnsnames.ora (e.g., *_high/*_medium/*_low)
ORACLE_TNS_ALIAS=mainbase_high

# Option B: mTLS using wallet (requires wallet files and password)
# ORACLE_WALLET_LOCATION=./wallet_dir
# ORACLE_WALLET_PASSWORD=your-wallet-password
# ORACLE_CONNECT_STRING=(description= (retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=your-host))(connect_data=(service_name=your-service))(security=(ssl_server_dn_match=yes)))

# Previous PostgreSQL Connection (for reference)
# DATABASE_URL_OLD=postgresql://user:password@host:port/database?sslmode=require

# Notion Integration
NOTION_API_KEY=your-notion-integration-api-key
CHAPEL_NOTION_DB_ID=your-chapel-services-notion-database-id
MEMORIAL_NOTION_DB_ID=e438c3bd041a4977baacde59ea4cc1e7

# SharePoint mirror (Microsoft Graph). Leave GRAPH_* unset to skip the write.
# Verify with: node scripts/sharepoint/check-app-permissions.js [--write]
GRAPH_TENANT_ID=your-entra-tenant-id
GRAPH_CLIENT_ID=your-app-registration-client-id
GRAPH_CLIENT_SECRET=your-app-registration-client-secret
# Delegated mode (no tenant admin needed): refresh token from
# `npm run oauth-login` in sharepoint-mcp-server (~/.config/bay-view-graph/tokens.json).
# Items are created as that user. Without it the app-only client-credentials
# flow is used, which needs the APPLICATION permission Sites.ReadWrite.All
# with admin consent.
GRAPH_REFRESH_TOKEN=
# Optional overrides (defaults: worship site, "Worship Applications" list)
# SHAREPOINT_SITE_URL=https://bayviewassociation.sharepoint.com/sites/worship
# SHAREPOINT_APPLICATIONS_LIST=8431f00a-907b-4e3b-bd8e-a22ccb26102e

# Admin Authentication
ADMIN_TOKEN=your-secure-admin-token

# Environment
NODE_ENV=development
