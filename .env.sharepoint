# 1Password references only — no secrets in this file.
# App-only check:
#   op run --env-file=.env.sharepoint -- node scripts/sharepoint/check-app-permissions.js --write
# Delegated check (refresh token from `npm run oauth-login` in sharepoint-mcp-server):
#   GRAPH_REFRESH_TOKEN=$(jq -r .refresh_token ~/.config/bay-view-graph/tokens.json) \
#     op run --env-file=.env.sharepoint -- node scripts/sharepoint/check-app-permissions.js --write
GRAPH_TENANT_ID="op://Remote Access Keys/Bay View Graph MCP - Azure AD/tenant_id"
GRAPH_CLIENT_ID="op://Remote Access Keys/Bay View Graph MCP - Azure AD/client_id"
GRAPH_CLIENT_SECRET="op://Remote Access Keys/Bay View Graph MCP - Azure AD/client_secret"
